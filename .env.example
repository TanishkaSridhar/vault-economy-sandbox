# VAULT language-model keys.
# Copy this file to .env (same folder) and fill in the keys you have.
# .env is git-ignored; never put real keys in this file, it IS committed.
# Any provider left blank is skipped; with no keys at all, agents use the rule brain.

# Groq (first choice): https://console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI (same model, second choice): https://dash.cloudflare.com
# The token needs "Workers AI" permission; the account ID is shown on the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google Gemini (third choice): https://aistudio.google.com/apikey
GEMINI_API_KEY=
